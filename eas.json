{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/eas.json",
  "cli": {
    "version": ">= 6.0.0"
  },
  "build": {
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://apiloginlexiarailwal-production.up.railway.app",
        "EXPO_PUBLIC_LEGAL_API_URL": "https://apilegalrailway-production.up.railway.app"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      }
    },
    "store": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://apiloginlexiarailwal-production.up.railway.app",
        "EXPO_PUBLIC_LEGAL_API_URL": "https://apilegalrailway-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
